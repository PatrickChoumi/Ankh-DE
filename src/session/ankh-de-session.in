#!/bin/sh
# Session d'Ankh DE (DE-010).
#
# Elle ne remplace ni le compositeur, ni le gestionnaire de session, ni le
# shell : elle lance la session de Plasma, en ayant d'abord placé nos valeurs
# par défaut dans XDG_CONFIG_DIRS.
#
# Pourquoi c'est nécessaire : le thème global ne sait pas porter les polices,
# le rendu, les durées d'animation ni l'accent qui suit le fond d'écran.
# Vérifié le 2026-11-05 : après « plasma-apply-lookandfeel -a », la clé
# « font » reste vide. L'outil ne recopie qu'un ensemble fixe de clés, et ni
# Breeze ni Fedora ne mettent de police dans leur « defaults ».
#
# Pourquoi XDG_CONFIG_DIRS plutôt qu'écrire dans un fichier : les valeurs y
# sont lues APRÈS celles de l'utilisateur, qui gardent donc la priorité, et
# AVANT celles de la distribution. Rien n'est écrasé, rien n'est écrit chez
# l'utilisateur, et quitter la session suffit à tout défaire.
set -eu

ANKH_DE_CONFIG="@ANKH_DE_CONFIGDIR@"

if [ ! -r "${ANKH_DE_CONFIG}/kdeglobals" ]; then
    echo "ankh-de-session : ${ANKH_DE_CONFIG}/kdeglobals est introuvable." >&2
    echo "L'installation d'Ankh DE est incomplète ; la session s'ouvrira sans" >&2
    echo "ses polices ni ses animations." >&2
fi

# La valeur par défaut de la spécification XDG est /etc/xdg : si la variable
# est vide, la remplacer sans la rétablir priverait la session des réglages
# de la distribution.
XDG_CONFIG_DIRS="${XDG_CONFIG_DIRS:-/etc/xdg}"
XDG_CONFIG_DIRS="${ANKH_DE_CONFIG}:${XDG_CONFIG_DIRS}"
export XDG_CONFIG_DIRS

# Qt et KWin ne cherchent leurs greffons que dans les chemins compilés dans
# Qt. Installé ailleurs que dans /usr — par exemple /usr/local, le défaut de
# l'installateur — notre style et notre décoration sont invisibles, et
# Plasma retombe sur Breeze SANS RIEN DIRE. Vérifié le 2026-11-05 :
# « plasma-apply-lookandfeel » n'écrit même pas widgetStyle quand il
# n'arrive pas à charger le greffon.
ANKH_DE_PLUGINDIR="@ANKH_DE_PLUGINDIR@"
if [ -d "${ANKH_DE_PLUGINDIR}" ]; then
    QT_PLUGIN_PATH="${ANKH_DE_PLUGINDIR}${QT_PLUGIN_PATH:+:${QT_PLUGIN_PATH}}"
    export QT_PLUGIN_PATH
fi

# Et où sont nos DONNÉES : applets, thèmes, styles Plasma, icônes, polices.
# Sans cela, une installation ailleurs que dans /usr est invisible pour la
# session — Plasma ne cherche que dans XDG_DATA_DIRS. Constaté le
# 2026-11-06 dans la VM : « org.ankh.demarrer » n'apparaissait même pas dans
# le journal, et la barre retombait sur Kickoff sans un mot.
ANKH_DE_DATADIR="@ANKH_DE_DATADIR@"
if [ -d "${ANKH_DE_DATADIR}" ]; then
    XDG_DATA_DIRS="${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
    case ":${XDG_DATA_DIRS}:" in
        *":${ANKH_DE_DATADIR}:"*) ;;
        *) XDG_DATA_DIRS="${ANKH_DE_DATADIR}:${XDG_DATA_DIRS}" ;;
    esac
    export XDG_DATA_DIRS
fi

# --- Les pièces que le thème DÉSIGNE existent-elles ? --------------------
#
# Notre thème global nomme un thème d'icônes, un style Plasma, des curseurs
# et des applets. Plasma ne dit rien quand l'un manque : il retombe sur le
# sien, et l'écran a l'air juste. C'est exactement ce qui a caché, plusieurs
# jours, que la barre affichée était celle de Breeze.
#
# Le cas n'est pas théorique : le paquet RPM ne porte PAS les pièces
# fabriquées par third_party/preparer.sh (applets, thème Plasma, icônes,
# curseurs, police). Qui installe le seul RPM obtient donc une session qui
# désigne des pièces absentes. On le DIT, une ligne par pièce, dans le
# journal de la session.
#
# C'est un avertissement, jamais un refus : une session dégradée reste une
# session, et laisser l'utilisateur dehors serait pire.
ankh_de_verifier_piece() { # $1 : libellé, $2 : chemin attendu
    if [ -e "$2" ]; then
        echo "ANKH-PIECE ok      $1"
    else
        echo "ANKH-PIECE ABSENTE $1 ($2) : Plasma retombera sur la sienne, sans le dire"
    fi
}
if [ -d "${ANKH_DE_DATADIR}" ]; then
    ankh_de_verifier_piece "applet Démarrer"   "${ANKH_DE_DATADIR}/plasma/plasmoids/org.ankh.demarrer"
    ankh_de_verifier_piece "applet barre"      "${ANKH_DE_DATADIR}/plasma/plasmoids/org.ankh.taches"
    ankh_de_verifier_piece "applet état"       "${ANKH_DE_DATADIR}/plasma/plasmoids/org.ankh.etat"
    ankh_de_verifier_piece "séparateur"        "${ANKH_DE_DATADIR}/plasma/plasmoids/org.ankh.separateur"
    ankh_de_verifier_piece "module QML partagé" "${ANKH_DE_DATADIR}/ankh-de/qml/Settings.qml"
    ankh_de_verifier_piece "style Plasma"      "${ANKH_DE_DATADIR}/plasma/desktoptheme/ankh"
    ankh_de_verifier_piece "thème d'icônes"    "${ANKH_DE_DATADIR}/icons/Fluent-Ankh"
    ankh_de_verifier_piece "curseurs"          "${ANKH_DE_DATADIR}/icons/Ankh-curseurs"
    ankh_de_verifier_piece "sélecteur Alt+Tab" "${ANKH_DE_DATADIR}/kwin/tabbox/ankh-selecteur"
fi

# Repère pour nos propres scripts et pour le signalement de bogues. Il ne
# remplace pas XDG_CURRENT_DESKTOP, qui reste « KDE » (voir ankh-de.desktop).
ANKH_DE_SESSION=1
export ANKH_DE_SESSION

# Plasma démarre normalement à travers ce lanceur, qui lui donne un bus de
# session s'il n'en a pas. Son chemin varie selon la distribution.
for wrapper in \
    /usr/libexec/plasma-dbus-run-session-if-needed \
    /usr/lib/plasma-dbus-run-session-if-needed \
    /usr/lib/x86_64-linux-gnu/libexec/plasma-dbus-run-session-if-needed \
    /usr/lib64/libexec/plasma-dbus-run-session-if-needed
do
    if [ -x "${wrapper}" ]; then
        exec "${wrapper}" startplasma-wayland "$@"
    fi
done

# Sans lui, on lance directement : Plasma sait aussi se passer du lanceur.
exec startplasma-wayland "$@"
