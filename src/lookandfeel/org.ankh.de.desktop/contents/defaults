# Réglages par défaut d'Ankh DE, portés par le thème global (DE-002, DE-010).
#
# Plasma lit ce fichier quand le thème global est appliqué
# (« plasma-apply-lookandfeel -a org.ankh.de.desktop », ou la page
# « Thème global » de la configuration du système).
#
# ATTENTION — l'outil ne recopie qu'un ENSEMBLE FIXE de clés. Vérifié le
# 2026-11-05 : les polices, le rendu, le facteur d'animation et l'accent qui
# suit le fond d'écran y étaient, et étaient silencieusement ignorés
# (« kreadconfig6 --group General --key font » rendait une chaîne vide). Ni
# Breeze ni Fedora n'en mettent dans leur propre fichier.
# Ces réglages-là vivent maintenant dans src/config/, que la session d'Ankh
# DE place dans XDG_CONFIG_DIRS (DE-010).
#
# N'ajouter ici que des clés dont on a VÉRIFIÉ qu'elles sont appliquées.
# Le test tests/session-et-theme.sh les relit toutes, une par une.
#
# Format : [<fichier de configuration>][<groupe>]
# Lu par klookandfeelmanager.cpp (libklookandfeel, plasma-workspace).

[kdeglobals][General]
# CLAIR par défaut, comme Windows 11 sorti de la boîte (DE-017).
#
# Le schéma sombre « Ankh » reste livré et se choisit dans les réglages. Les
# deux identifiants gardent leur nom — les renommer toucherait cinq fichiers
# pour zéro gain visible — mais leurs valeurs sont celles de WinUI depuis le
# 2026-11-08 : fond #F3F3F3, texte #1A1A1A, accent #0078D4.
#
# Au passage, « AnkhClair » était construit et installé depuis le lot 1 sans
# que RIEN ne le sélectionne jamais.
ColorScheme=AnkhClair

[kdeglobals][Icons]
# Icônes Fluent, variante « yellow » : le jaune des dossiers de Windows 11,
# relevé à #ffcd3e–#ffd14d sur une capture et servi par Fluent à #ffcb52.
# Fabriquées par third_party/preparer.sh depuis un commit figé. Sans lui,
# le thème est absent : le test le signale au lieu de laisser Plasma
# retomber en silence sur les icônes de la distribution.
Theme=Fluent-Ankh

[kdeglobals][KDE]
# Le style des contrôles, aux mesures de WinUI (lot 3).
# ATTENTION : l'outil n'écrit cette clé que s'il arrive à CHARGER le greffon
# (vérifié le 2026-11-05 : sans QT_PLUGIN_PATH, elle est omise en silence).
# C'est pourquoi la session pose QT_PLUGIN_PATH sur notre préfixe.
widgetStyle=Ankh

[kcminputrc][Mouse]
# Curseurs Fluent blancs, anneau d'attente à l'accent de Windows (#0078d4),
# repris tel quel depuis le 2026-11-08.
cursorTheme=Ankh-curseurs
cursorSize=24

[kwinrc][org.kde.kdecoration2]
# KDecoration3 lit encore ce groupe sous Plasma 6.
# ButtonsOnLeft et ButtonsOnRight ne sont PAS ici : vérifié le 2026-11-05,
# l'outil ne les écrit jamais. Ils sont dans src/config/kwinrc, que la
# session place dans XDG_CONFIG_DIRS (DE-010).
library=org.ankh.decoration
BorderSize=None
BorderSizeAuto=false

[plasmarc][Theme]
# Style Plasma clair, pour aller avec le schéma clair (DE-017). Dérivé des
# SVG de KDE-Windows-Modern (GPL-3.0) ; depuis le 2026-11-08 ses accents de
# Windows sont GARDÉS, et seuls les bleus de Breeze restés dans sa base sont
# amenés sur ceux de Windows. Fabriqué par third_party/preparer.sh.
#
# « ankh-clair » était lui aussi construit et installé sans jamais être
# sélectionné.
name=ankh-clair

[ksplashrc][KSplash]
# Écran de chargement d'Ankh (contents/splash/Splash.qml), fait le 2026-11-05.
Theme=org.ankh.de.desktop
Engine=KSplashQML

[Wallpaper]
Image=org.kde.image

# --- Désactivés tant que la pièce désignée n'existe pas -------------------
# Un thème qui désigne une pièce absente n'est pas neutre : Plasma retombe en
# silence sur la sienne, et on croit que le réglage est appliqué. Chacune de
# ces lignes revient le jour où sa pièce est livrée (AUDIT.md §1.2).
#
# --- L'écran de VERROUILLAGE reste celui de Plasma, et c'est délibéré -----
# Ce n'est pas une pièce décorative : c'est elle qui déverrouille la machine.
# Un écran de verrouillage dérivé qui plante, ou dont le champ de mot de passe
# ne reçoit pas le clavier, enferme l'utilisateur dehors — avec, pour seule
# issue, un changement de console ou un redémarrage forcé. On ne prend pas ce
# risque pour une question d'allure. Il sera repris au lot 7, en VM, avec un
# essai de déverrouillage réel avant toute livraison.
#
# [kscreenlockerrc][Greeter]
# Theme=org.ankh.de.desktop
