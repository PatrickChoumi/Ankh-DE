# Valeurs par défaut de KWin pour Ankh DE que le thème global ne porte pas
# (DE-010). Même mécanisme que kdeglobals : lues par XDG_CONFIG_DIRS, donc
# après les réglages de l'utilisateur et avant ceux de la distribution.
#
# La décoration elle-même (library, BorderSize) est portée par le thème
# global, qui sait le faire. Mais PAS la disposition des boutons : vérifié le
# 2026-11-05, « plasma-apply-lookandfeel » n'écrit jamais ButtonsOnLeft ni
# ButtonsOnRight. Sans ces deux lignes, les fenêtres n'auraient pas les
# boutons de Windows 11.

[org.kde.kdecoration2]
# L'icône de l'application à gauche (M), puis réduire, agrandir et fermer à
# droite (IAX) : la disposition de Windows 11
# (pages basics/titlebar-design et develop/title-bar de Microsoft).
ButtonsOnLeft=M
ButtonsOnRight=IAX

[Effect-blur]
# Verre de Windows 11 : Acrylic, flou de rayon 30 et grain de 0,02
# (AcrylicBrush.h de WinUI). Les échelles de KWin ne sont pas celles de
# Windows : ces deux valeurs sont un point de départ, à mesurer au lot 4.
BlurStrength=10
NoiseStrength=2

[TabBox]
# Alt+Tab : « Thumbnail Grid », le sélecteur NATIF de KWin (DE-015).
#
# C'est une grille de grandes vignettes — la forme même de l'Alt+Tab de
# Windows 11 — et elle est livrée par KWin lui-même
# (src/tabbox/switchers/thumbnail_grid, KPackageStructure
# KWin/WindowSwitcher), pas par plasma-workspace : elle est donc présente
# partout où KWin est présent, Plasma 6.6 de la cible Ubuntu 26.04 comprise.
# Vérifié sur la branche Plasma/6.6 de plasma/kwin, Id « thumbnail_grid ».
#
# Elle remplace « ankh-selecteur », repris de Tidewater, qui n'a JAMAIS été
# montré à l'écran : trois passages en VM de suite n'ont pas réussi à le
# déclencher, faute d'une seconde fenêtre à lui donner. Garder un sélecteur
# maison non éprouvé en écartant celui de KWin, c'était prendre un risque
# sans contrepartie (DE-015, « configurer le natif avant d'importer »).
#
# Au passage, cela supprime un piège documenté dans docs/INSTALL.md : KWin
# garde le code d'un sélecteur EN MÉMOIRE, par nom de paquet, jusqu'à la
# déconnexion, si bien qu'une mise à jour du nôtre ne prenait qu'à la
# session suivante. Le sélecteur de KWin, lui, est mis à jour avec KWin.
LayoutName=thumbnail_grid
